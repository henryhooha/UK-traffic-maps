# Copy to .env and fill in what you have. Everything is optional — with nothing
# set the app runs with TfL live data + the smart-motorway demo simulator.

PORT=3000
# Your email, sent to Nominatim per its usage policy
CONTACT_EMAIL=

# ---- Routing / geocoding (public demo servers by default; self-host for real use)
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# ENABLE_OVERPASS=true

# ---- Transport for London (public; key optional, raises rate limits)
ENABLE_TFL=true
TFL_APP_KEY=

# ---- National Highways NTIS (England's motorways & major A-roads) — DATEX II
# Subscribe via National Highways to get endpoint URLs + credentials.
# Use whichever auth your subscription gives you (basic auth or a subscription key).
NH_SITUATIONS_URL=
NH_PLANNED_URL=
NH_VMS_TABLE_URL=
NH_VMS_STATUS_URL=
NH_SIGNAL_TABLE_URL=
NH_SIGNAL_STATUS_URL=
NH_USERNAME=
NH_PASSWORD=
NH_SUBSCRIPTION_KEY=
NH_POLL_MS=60000

# ---- Traffic Scotland — DATEX II
TS_SITUATIONS_URL=
TS_ROADWORKS_URL=
TS_VMS_TABLE_URL=
TS_VMS_STATUS_URL=
TS_USERNAME=
TS_PASSWORD=

# ---- Any other DATEX II feed (e.g. Traffic Wales), as JSON
# DATEX2_FEEDS=[{"name":"traffic-wales","label":"Traffic Wales","urls":{"situations":"https://..."},"headers":{}}]

# Demo simulator: defaults to ON when no DATEX II feed is configured, OFF otherwise.
# DEMO_MODE=false
